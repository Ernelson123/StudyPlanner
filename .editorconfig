root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,vb}]
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_prefer_auto_properties = true:silent
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

# Nomenclatura
dotnet_naming_rule.interfaces_should_begin_with_I.severity = warning
dotnet_naming_rule.interfaces_should_begin_with_I.symbols = interface_symbols
dotnet_naming_rule.interfaces_should_begin_with_I.style = begin_with_I
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.begin_with_I.capitalization = pascal_case
dotnet_naming_style.begin_with_I.required_prefix = I

# Fase 1: Interfaces vazias são intencionais (contratos de arquitetura limpa)
dotnet_diagnostic.CA1040.severity = none
# Fase 1: Classes internas são registradas via DI (falso positivo)
dotnet_diagnostic.CA1812.severity = none
# Fase 1: Classes não seladas permitem mocking em testes
dotnet_diagnostic.CA1852.severity = none
# WPF não usa ConfigureAwait na UI thread
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1707.severity = none
