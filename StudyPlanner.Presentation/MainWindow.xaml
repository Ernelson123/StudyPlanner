<Window x:Class="StudyPlanner.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:StudyPlanner.Presentation.ViewModels"
        xmlns:converters="clr-namespace:StudyPlanner.Presentation.Converters"
        mc:Ignorable="d"
        Title="Study Planner"
        Height="854"
        Width="1114"
        MinHeight="620"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="White"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <!-- ========================================================= -->
    <!-- RESOURCES -->
    <!-- ========================================================= -->

    <Window.Resources>

        <converters:BoolToStringConverter x:Key="BoolToTextConverter"/>
        <converters:HoursToStringConverter x:Key="HoursToStringConverter"/>

        <!-- CARD STYLE -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- MODERN BUTTON -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2F2F2F"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CHIP STYLE -->
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- SCROLLVIEWER STYLE (Optional: Makes scrollbar look modern) -->
        <Style x:Key="ModernScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
            <!-- Space for scrollbar -->
        </Style>

        <!-- MODERN TEXTBOX STYLE -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2F2F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="16">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5,0,5,0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ========================================================= -->
    <!-- MAIN -->
    <!-- ========================================================= -->

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- TOP HEADER -->
        <!-- ===================================================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Logo & Title -->
            <StackPanel Orientation="Horizontal">
                <Border Width="62" Height="62" CornerRadius="18" Background="#3794FF" VerticalAlignment="Center">
                    <TextBlock Text="📘" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0"/>
                </Border>
                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Study Planner" FontSize="28" FontWeight="Bold"/>
                    <!-- Bind Date if you have a property, otherwise keep static or add one to VM -->
                    <TextBlock Text="{Binding CurrentDate, StringFormat='{}{0:dddd, dd MMMM}', FallbackValue='terça-feira, 12 de maio'}" 
                           FontSize="18" Foreground="#A0A0A0" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- RIGHT STATS: Bound to Real Data -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Total Time Studied Today (You might need to add this property to VM) -->
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏱" Margin="0,0,10,0"/>
                        <!-- Placeholder binding until you add 'TotalMinutesToday' to VM -->
                        <TextBlock Text="{Binding TotalMinutesToday, StringFormat='{}{0}m studied', FallbackValue='0m studied'}" 
                               FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                </Border>

                <!-- Session Count -->
                <Border Style="{StaticResource ChipStyle}" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📚" Margin="0,0,10,0"/>
                        <!-- Bind to Subjects.Count or Sessions.Count -->
                        <TextBlock Text="{Binding Subjects.Count, StringFormat='{}{0} subjects', FallbackValue='0 sessions'}" 
                               FontWeight="SemiBold" FontSize="18"/>
                    </StackPanel>
                </Border>

                <!-- Settings Button (Added for functionality) -->
                <Button Command="{Binding OpenSettingsCommand}" 
                    Style="{StaticResource ModernButtonStyle}" 
                    Padding="12" Margin="10,0,0,0"
                    ToolTip="Settings">
                    <TextBlock Text="⚙️" FontSize="20"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================================================== -->
        <!-- CONTENT (SCROLLABLE) -->
        <!-- ===================================================== -->
        <ScrollViewer Grid.Row="2" Style="{StaticResource ModernScrollViewerStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Left: Subjects -->
                    <ColumnDefinition Width="520"/>
                    <!-- Right: Timer -->
                </Grid.ColumnDefinitions>

                <!-- ================================================= -->
                <!-- LEFT SIDE: SUBJECTS LIST -->
                <!-- ================================================= -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,20,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Input Area -->
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <!-- Title -->
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                            <!-- List -->
                        </Grid.RowDefinitions>

                        <!-- INPUT AREA: Add New Subject -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" 
                                 Style="{StaticResource ModernTextBoxStyle}" 
                                 Text="{Binding NewSubjectName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Subject Name"/>

                                <TextBox Grid.Column="2" 
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding NewPriority, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Priority (1-10)"/>

                                <!-- Add Button -->
                                <Button Grid.Column="2" Visibility="Collapsed"/>
                                <!-- Hidden, we use the TextBox as trigger or add a separate button below -->
                        </Grid>

                        <!-- Better Input Layout -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox Width="200" 
                                  Background="#2F2F2F" BorderBrush="#4A4A4A" BorderThickness="1"
                                  Text="{Binding NewSubjectName, UpdateSourceTrigger=PropertyChanged}"
                                  Foreground="White" Padding="12,10"
                                  ToolTip="Subject Name"/>
                            <TextBox Width="60" Margin="10,0,0,0"
                                  Background="#2F2F2F" BorderBrush="#4A4A4A" BorderThickness="1"
                                  Text="{Binding NewPriority, UpdateSourceTrigger=PropertyChanged}"
                                  Foreground="White" Padding="12,10"
                                  ToolTip="Priority"/>
                            <Button Content="Add" 
                                 Command="{Binding AddSubjectCommand}"
                                 Style="{StaticResource ModernButtonStyle}" 
                                 Margin="10,0,0,0" Padding="12,10"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="SUBJECTS" FontSize="18" FontWeight="SemiBold" Foreground="#A0A0A0"/>

                        <!-- SUBJECT LIST: REAL DATA -->
                        <ListBox Grid.Row="4" 
                             ItemsSource="{Binding Subjects}" 
                             SelectedItem="{Binding SelectedSubject}"
                             Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="12" Padding="12" Margin="0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Priority Dot -->
                                                        <Ellipse Grid.Column="0" Width="12" Height="12" Fill="#FF4D6D" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                                        <!-- Name -->
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16" VerticalAlignment="Center"/>

                                                        <!-- Priority Weight -->
                                                        <TextBlock Grid.Column="2" Text="{Binding PriorityWeight}" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#3794FF"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#3A3A3A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- ================================================= -->
                <!-- RIGHT SIDE: POMODORO TIMER -->
                <!-- ================================================= -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Header -->
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="Auto"/>
                            <!-- Modes -->
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="Auto"/>
                            <!-- Timer Circle -->
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="Auto"/>
                            <!-- Controls -->
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="Auto"/>
                            <!-- Stats -->
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="Auto"/>
                            <!-- Dots -->
                        </Grid.RowDefinitions>

                        <!-- HEADER: Timer Mode & Subject Selection -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="⏱ Pomodoro Timer" FontSize="20" FontWeight="SemiBold"/>

                            <!-- Subject Selector for Timer -->
                            <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding Subjects}" 
                                  SelectedItem="{Binding SelectedSubject}"
                                  DisplayMemberPath="Name"
                                  Width="180"
                                  Background="#252525" Foreground="White"
                                  BorderBrush="#4A4A4A" BorderThickness="1"
                                  Padding="10">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#252525"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </Grid>

                        <!-- MODES: Focus / Break / Long Break -->
                        <UniformGrid Grid.Row="2" Columns="3">
                            <!-- Note: You need commands in ViewModel to switch modes. 
                             For now, these are visual. If you have SetModeCommand, bind it. -->
                            <Button Content="Focus&#10;25m" Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0" Height="92"/>
                            <Button Content="Break&#10;5m" Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0" Height="92"/>
                            <Button Content="Long&#10;15m" Style="{StaticResource ModernButtonStyle}" Height="92"/>
                        </UniformGrid>

                        <!-- TIMER CIRCLE -->
                        <Grid Grid.Row="4" Width="250" Height="250" HorizontalAlignment="Center">
                            <Ellipse Stroke="#1F1F1F" StrokeThickness="20"/>
                            <Ellipse Stroke="#18C28E" StrokeThickness="20" 
                                 StrokeDashArray="900" 
                                 StrokeDashOffset="{Binding TimerDashOffset}" 
                                 RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TimerDisplay}" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentState}" FontSize="20" Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- CONTROLS: Start / Stop -->
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="▶ Start" Height="70" FontSize="26" 
                                Command="{Binding StartTimerCommand}"
                                Style="{StaticResource ModernButtonStyle}"/>

                            <Button Grid.Column="2" Content="↺ Reset" Height="70" FontSize="22" 
                                Command="{Binding StopTimerCommand}"
                                Style="{StaticResource ModernButtonStyle}"/>
                        </Grid>

                        <!-- SESSIONS TODAY -->
                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sessions today" FontSize="18" Foreground="#A0A0A0"/>
                            <!-- Bind to a property like 'SessionsCompletedToday' -->
                            <TextBlock Grid.Column="1" Text="0 / 8" FontSize="18" Foreground="#A0A0A0"/>
                        </Grid>

                        <!-- SESSION DOTS -->
                        <UniformGrid Grid.Row="10" Columns="8">
                            <!-- You can bind these to a list of booleans or just keep them static for now -->
                            <Border Background="#252525" CornerRadius="8" Height="42" Margin="0,0,8,0"/>
                            <Border Background="#252525" CornerRadius="8" Height="42" Margin="0,0,8,0"/>
                            <Border Background="#252525" CornerRadius="8" Height="42" Margin="0,0,8,0"/>
                            <Border Background="#252525" CornerRadius="8" Height="42" Margin="0,0,8,0"/>
                            <Border Background="#252525" CornerRadius="8" Height="42" Margin="0,0,8,0"/>
                            <Border Background="#252525" CornerRadius="8" Height="42" Margin="0,0,8,0"/>
                            <Border Background="#252525" CornerRadius="8" Height="42" Margin="0,0,8,0"/>
                            <Border Background="#252525" CornerRadius="8" Height="42"/>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>

</Window>
