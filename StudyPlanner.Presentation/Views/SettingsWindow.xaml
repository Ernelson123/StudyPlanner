<Window x:Class="StudyPlanner.Presentation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StudyPlanner.Presentation.ViewModels"
        Title="Pomodoro Settings" Height="320" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Timer Durations" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- Work Duration -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
            <TextBlock Text="Work:" Width="80" VerticalAlignment="Center"/>
            <TextBox Width="60" Text="{Binding WorkMinutes, UpdateSourceTrigger=PropertyChanged}" 
                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"/>
            <TextBlock Text="min" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>

        <!-- Short Break -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8">
            <TextBlock Text="Short Break:" Width="80" VerticalAlignment="Center"/>
            <TextBox Width="60" Text="{Binding ShortBreakMinutes, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"/>
            <TextBlock Text="min" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>

        <!-- Long Break -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8">
            <TextBlock Text="Long Break:" Width="80" VerticalAlignment="Center"/>
            <TextBox Width="60" Text="{Binding LongBreakMinutes, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"/>
            <TextBlock Text="min" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="16,8" Margin="0,0,8,0" 
                    Command="{Binding CloseWindowCommand}" Background="{DynamicResource BorderBrush}"/>
            <Button Content="Save Changes" Padding="16,8" 
                    Command="{Binding SaveSettingsCommand}" Background="{DynamicResource PrimaryBrush}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
