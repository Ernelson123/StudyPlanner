<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
    <!-- Main Window Background -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#252525"/>
    <!-- Cards/Panels -->
    <SolidColorBrush x:Key="HeaderBrush" Color="#2D2D2D"/>
    <!-- Header Area -->

    <!-- Text Colors -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF"/>
    <!-- Primary Text -->
    <SolidColorBrush x:Key="MutedBrush" Color="#A0A0A0"/>
    <!-- Secondary/Disabled Text -->

    <!-- Accents (Teal/Green from the image) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#20C997"/>
    <!-- Main Accent (Teal) -->
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#17A589"/>
    <!-- Hover State -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#20C997"/>
    <!-- Start Button -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B"/>
    <!-- Stop/Reset Button -->

    <!-- Borders & Inputs -->
    <SolidColorBrush x:Key="BorderBrush" Color="#3E3E3E"/>
    <!-- Card Borders -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#333333"/>
    <!-- TextBox Backgrounds -->

    <!-- Timer Specifics -->
    <SolidColorBrush x:Key="CircleTrackBrush" Color="#3E3E3E"/>
    <!-- Grey Track -->
    <SolidColorBrush x:Key="CircleProgressBrush" Color="#20C997"/>
    <!-- Teal Progress -->
</ResourceDictionary>
