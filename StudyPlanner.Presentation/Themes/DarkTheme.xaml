<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cores Principais -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>

    <!-- Cores de Ação -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>

    <!-- Bordas e Divisores -->
    <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="CircleTrackBrush" Color="#334155"/>
    <SolidColorBrush x:Key="CircleProgressBrush" Color="#60A5FA"/>
</ResourceDictionary>
