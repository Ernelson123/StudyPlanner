<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
      <!-- <NeutralLanguage>en-US</NeutralLanguage> -->
      <!--<SatelliteResourceLanguages>en</SatelliteResourceLanguages> -->
      <DisableEmbeddedXaml>false</DisableEmbeddedXaml>
      <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
      <!-- CRITICAL: Disable invariant globalization -->
      <InvariantGlobalization>false</InvariantGlobalization>
      <!-- Suppress NU1701 warnings for compatible packages -->
      <NoWarn>$(NoWarn);NU1701</NoWarn>
      <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1701</WarningsNotAsErrors>
      <!-- Suppress warnings -->
      <NoWarn>$(NoWarn);NU1701;CA1416;CA1305;CA2254</NoWarn>
      <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1701;CA1416;CA1305;CA2254</WarningsNotAsErrors>
      <!-- ========== DEPLOYMENT SETTINGS ========== -->

      <!-- PublishSingleFile: Creates one .exe instead of many DLLs -->
      <!-- This makes distribution easier (just copy one file) -->
      <PublishSingleFile>true</PublishSingleFile>

      <!-- SelfContained: Includes .NET runtime in the .exe -->
      <!-- Users don't need to install .NET separately -->
      <!-- Increases file size but improves compatibility -->
      <SelfContained>true</SelfContained>

      <!-- RuntimeIdentifier: Target Windows x64 (64-bit) -->
      <!-- This is the most common Windows architecture -->
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>

      <!-- PublishReadyToRun: Pre-compiles code for faster startup -->
      <!-- Trades slightly larger size for better performance -->
      <PublishReadyToRun>true</PublishReadyToRun>

      <!-- IncludeNativeLibrariesForSelfExtract: Bundles native DLLs -->
      <!-- Required for QuestPDF and other native dependencies -->
      <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="LiveChartsCore" Version="2.0.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="QuestPDF" Version="2026.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StudyPlanner.Application\StudyPlanner.Application.csproj" />
    <ProjectReference Include="..\StudyPlanner.Data\StudyPlanner.Data.csproj" />
  </ItemGroup>

</Project>
